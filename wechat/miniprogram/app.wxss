page {height:100%;background:#f1f7f5;color:#172927;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:17px;line-height:1.5;}
view,text,button,input,textarea,picker,scroll-view {box-sizing:border-box;}
button {margin:0;padding:0;border:0;border-radius:0;background:transparent;color:inherit;font-size:inherit;line-height:inherit;}
button::after {border:0;}
button[disabled] {opacity:.6;}
input,textarea {color:inherit;font-size:inherit;}
image {display:block;box-sizing:border-box;}
